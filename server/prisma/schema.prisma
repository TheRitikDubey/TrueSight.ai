generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  avatar       String?
  googleId     String        @unique
  authProvider String        @default("google")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
}

model AuthSession {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model OAuthAttempt {
  stateHash    String   @id
  browserHash  String
  codeVerifier String
  nonce        String
  returnTo     String
  expiresAt    DateTime

  @@index([expiresAt])
}

model Conversation {
  id              String    @id @default(cuid())
  ownerId         String
  title           String    @default("New conversation")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  generationId    String?
  generatingUntil DateTime?
  messages        Message[]

  @@index([ownerId, updatedAt, id])
}

model Message {
  id             String       @id @default(uuid())
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  verifyWeb      Boolean      @default(false)
  evidence       Json?
  replyToId      String?      @unique
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

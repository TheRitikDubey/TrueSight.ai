# Ollama defaults (no paid LLM API key required)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Auto-detected for port 11434. Set explicitly for a custom Ollama port/proxy.
LLM_PROVIDER=ollama
# Disable thinking for faster structured extraction and evidence comparison.
LLM_THINK=false
# For a non-Ollama OpenAI-compatible local server, use LLM_PROVIDER=openai.
# LLM_API_KEY=

# Obtain a search API key at https://app.tavily.com
TAVILY_API_KEY=
# basic is faster; advanced is optional for more detailed searches.
SEARCH_DEPTH=basic
PORT=3001

# PostgreSQL chat history (server only)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/truesight"

# Google authentication (server only). Create a Web application OAuth client in
# Google Cloud Console > Google Auth Platform > Clients, after configuring branding/audience.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public app origin; no path. Vite proxies /api to Express during development.
FRONTEND_URL=http://localhost:5173
# Register this EXACT URI in the Google client's Authorized redirect URIs.
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
# Production: FRONTEND_URL=https://YOUR_APP_DOMAIN and
# GOOGLE_CALLBACK_URL=https://YOUR_APP_DOMAIN/api/auth/google/callback
# Serve the app and /api on the same public HTTPS origin. Set NODE_ENV=production
# in deployment for Secure cookies. Database-backed opaque sessions need no JWT/session secret.

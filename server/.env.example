# Ollama defaults (no paid LLM API key required)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Auto-detected for port 11434. Set explicitly for a custom Ollama port/proxy.
LLM_PROVIDER=ollama
# Disable thinking for faster structured extraction and evidence comparison.
LLM_THINK=false
# For a non-Ollama OpenAI-compatible local server, use LLM_PROVIDER=openai.
# LLM_API_KEY=

# Obtain a search API key at https://app.tavily.com
TAVILY_API_KEY=
# basic is faster; advanced is optional for more detailed searches.
SEARCH_DEPTH=basic
PORT=3001
